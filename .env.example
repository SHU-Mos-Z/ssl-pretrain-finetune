# Copy this file to .env.local, replace every example path, and export it with:
#   set -a; source .env.local; set +a
# .env.local is ignored by Git.

# Hardware shared by sequential experiment launchers.
CUDA_VISIBLE_DEVICES="0,1"
NUM_GPUS="2"
BATCH_SIZE_PER_GPU="4"
LR="4e-4"

# Checkpoints are deliberately not stored in Git.
PRETRAIN_CKPT="/absolute/path/to/checkpoints/ckpt_last.pth"

# Select one concrete, manually prepared split triplet per run.
TRAIN_ROOT="/absolute/path/to/dataset/finetune_train"
VAL_ROOT="/absolute/path/to/dataset/finetune_val"
TEST_ROOT="/absolute/path/to/dataset/finetune_test"

# Optional: override only when invoking a sequential runner from another copy
# of its experiment directory.
# SCRIPT_DIR="/absolute/path/to/DFS3R-main/scripts/test_seg_puad_0906"
